# Copy this to `delve.env` (gitignored) and fill it in. PM2 reads it via delve.config.js and passes
# these to the JVM as environment variables; delve.properties resolves them.

# REQUIRED: the Discord bot token for THIS bot (delve) — distinct from ukulele's.
DISCORD_TOKEN=

# --- Optional: web interface (browser play via Discord OAuth) -------------------------------------
# WEB_ENABLED=true
# DISCORD_OAUTH_CLIENT_ID=
# DISCORD_OAUTH_CLIENT_SECRET=
# WEB_PORT=8080
# WEB_ALLOWED_USER_IDS=         # comma-separated Discord ids; empty = any logged-in Discord user
# WEB_COOKIE_SECURE=true        # set true once you're behind HTTPS
